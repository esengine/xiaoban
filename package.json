{
  "name": "xiaoban",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen:protocol": "node scripts/gen-protocol.ts",
    "dev:desktop": "pnpm --filter @xiaoban/desktop tauri dev",
    "dev:mobile": "pnpm --filter @xiaoban/mobile start",
    "dev:hub": "cargo run -p xiaoban-hub",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && cargo test --workspace",
    "lint": "biome check . && node scripts/check-i18n.ts && cargo clippy --workspace --all-targets -- -D warnings",
    "format": "biome check --write . && cargo fmt --all",
    "gen:i18n": "node scripts/gen-i18n.ts",
    "gen": "pnpm gen:protocol && pnpm gen:i18n && pnpm gen:icons",
    "gen:icons": "node scripts/gen-provider-icons.ts && node scripts/gen-app-icons.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@fluent/syntax": "^0.19.0",
    "@lobehub/icons-static-svg": "^1.101.0",
    "@resvg/resvg-js": "^2.6.2",
    "turbo": "^2.11.10"
  }
}
