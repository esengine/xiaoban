{
  "expo": {
    "name": "Xiaoban",
    "slug": "xiaoban",
    "scheme": "xiaoban",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.xiaoban.mobile",
      "infoPlist": {
        "NSBonjourServices": ["_xiaoban._tcp"]
      }
    },
    "android": {
      "package": "app.xiaoban.mobile"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-status-bar", "expo-localization"],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "zh-Hans": "../../locales/native/zh-Hans.json",
      "en": "../../locales/native/en.json"
    }
  }
}
