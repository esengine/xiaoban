{
  "expo": {
    "name": "Xiaoban",
    "slug": "xiaoban",
    "scheme": "xiaoban",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.xiaoban.mobile",
      "infoPlist": {
        "NSBonjourServices": ["_xiaoban._tcp"]
      }
    },
    "android": {
      "package": "app.xiaoban.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3451D1"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/with-short-object-paths.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "zh-Hans": "../../locales/native/zh-Hans.json",
      "en": "../../locales/native/en.json"
    },
    "icon": "./assets/icon.png"
  }
}
