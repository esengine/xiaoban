{
  "expo": {
    "name": "Xiaoban",
    "slug": "xiaoban",
    "scheme": "xiaoban",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.xiaoban.mobile",
      "infoPlist": {
        "NSBonjourServices": ["_xiaoban._tcp"]
      }
    },
    "android": {
      "package": "app.xiaoban.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3451D1"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Xiaoban uses the camera only to scan the pairing QR code on your computer.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Used to hear you and turn speech into text, only while you hold the microphone.",
          "speechRecognitionPermission": "Turns what you say into text while you hold the microphone.",
          "androidSpeechServicePackages": [
            "com.xiaomi.mibrain.speech",
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Adds the events you confirm to your calendar and reads it to answer what is coming up. Nothing is uploaded."
        }
      ],
      "./plugins/with-short-object-paths.js",
      "./plugins/with-release-signing.js",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "zh-Hans": "../../locales/native/zh-Hans.json",
      "en": "../../locales/native/en.json"
    },
    "icon": "./assets/icon.png"
  }
}
